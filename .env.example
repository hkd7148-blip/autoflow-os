# ============================================
# AUTOFLOW OS - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# --------------------------------------------
# Telegram Bot Configuration
# --------------------------------------------
# Get token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Admin user IDs (comma-separated)
TELEGRAM_ADMIN_IDS=123456789,987654321

# --------------------------------------------
# Database Configuration
# --------------------------------------------
# PostgreSQL connection string
DATABASE_URL=postgresql://autoflow:password@localhost:5432/autoflow_db

# Redis connection string
REDIS_URL=redis://localhost:6379/0

# --------------------------------------------
# AI Configuration
# --------------------------------------------
# OpenAI API Key (for GPT-4)
OPENAI_API_KEY=sk-...

# Or Anthropic API Key (for Claude)
ANTHROPIC_API_KEY=sk-ant-...

# AI Model to use
AI_MODEL=gpt-4-turbo-preview
# AI_MODEL=claude-3-opus-20240229

# --------------------------------------------
# 1C Integration
# --------------------------------------------
# 1C REST API endpoint
ONEC_API_URL=http://localhost:8080/api/v1

# 1C API authentication token
ONEC_API_TOKEN=your_1c_token_here

# 1C sync interval (seconds)
ONEC_SYNC_INTERVAL=300

# --------------------------------------------
# SMS Gateway (optional)
# --------------------------------------------
# SMS provider API key
SMS_API_KEY=your_sms_api_key

# SMS sender name
SMS_SENDER_NAME=AUTOFLOW

# --------------------------------------------
# Application Settings
# --------------------------------------------
# Environment: development, staging, production
ENVIRONMENT=development

# Debug mode (true/false)
DEBUG=true

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Secret key for JWT tokens
SECRET_KEY=your-super-secret-key-change-in-production

# --------------------------------------------
# Server Configuration
# --------------------------------------------
# API host and port
API_HOST=0.0.0.0
API_PORT=8000

# Webhook URL (for production)
WEBHOOK_URL=https://your-domain.com/webhook

# --------------------------------------------
# ChromaDB (Vector Database)
# --------------------------------------------
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=autoflow_knowledge
